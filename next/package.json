{
  "name": "shrimpy-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The rebuild of Shrimpy on Pi's durable runtime. Moves into src/ when it replaces the old tree.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src lint",
    "test": "node --test \"src/**/*.test.ts\" \"lint/**/*.test.js\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-client": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-protocol": "1.0.0",
    "@earendil-works/pi-server": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint": "^10.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
