{
  "name": "shrimpy",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A home for agents, built on Pi's durable runtime.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "shrimpy": "node src/cli/main.ts",
    "readme": "node src/cli/readme/update.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/clients/web",
    "lint": "eslint src lint",
    "test": "node --test \"src/**/*.test.ts\" \"lint/**/*.test.js\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "cron-parser": "5.5.0",
    "esbuild": "0.28.2",
    "marked": "18.0.11",
    "preact": "11.2.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "eslint": "^10.3.0",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
