{
  "name": "shrimpy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A home for agents, built on Pi's durable runtime.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "shrimpy": "node src/cli/main.ts",
    "readme": "node src/cli/readme/update.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src lint",
    "test": "node --test \"src/**/*.test.ts\" \"lint/**/*.test.js\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-client": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-protocol": "1.0.0",
    "@earendil-works/pi-server": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "cron-parser": "5.5.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "^10.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
